# Only what `uv sync --locked --no-dev` needs is sent to the docker daemon.

# Local artifacts, the same list as brain/.gitignore.
.venv
**/__pycache__
*.py[cod]
.coverage
.pytest_cache
.ruff_cache

# The image runs its base image's Python, so the file naming the checks' interpreter stays out.
.python-version

# Tests are not in the image; they run on the host through `just check`.
**/tests

# The docker files themselves.
Dockerfile*
.dockerignore
.gitignore
